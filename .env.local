# Local development config — TRACKED and secret-free.
# Copy real secrets into an untracked .env (git-ignored) for actual runs.

# Application
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=change_me
IS_PUBLIC_KEY=public

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=invitae_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=invitae_db
DATABASE_URL=postgresql://invitae_user:change_me@localhost:5432/invitae_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# WhatsApp
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=change_me
WHATSAPP_APP_SECRET=change_me
WHATSAPP_VERIFY_TOKEN=change_me
WHATSAPP_PHONE_NUMBER_ID=change_me

# SMS
SMS_API_URL=https://api.sms.example.com
SMS_API_TOKEN=change_me

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=change_me
MAIL_PASS=change_me
