# =============================================================================
# Environment template — copy to an untracked .env / .env.local and fill in
# REAL secrets. THIS file is the only tracked one and MUST NOT contain real
# credentials; .env and .env.local are git-ignored (.gitignore: `.env.*`).
# Values marked change_me are required for the app to boot (see secrets.validator.ts).
# =============================================================================

# Application
NODE_ENV=development
PORT=3000

# JWT (token signing key — use a strong random value per environment)
JWT_SECRET=change_me
IS_PUBLIC_KEY=public

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=invitae_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=invitae_db
DATABASE_URL=postgresql://invitae_user:change_me@localhost:5432/invitae_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=placeholder

# WhatsApp — Meta Graph API + webhook (required by the bot)
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_API_TOKEN=change_me
WHATSAPP_APP_SECRET=change_me
WHATSAPP_VERIFY_TOKEN=change_me
WHATSAPP_PHONE_NUMBER_ID=change_me

# SMS
SMS_API_URL=https://api.sms.example.com
SMS_API_TOKEN=change_me

# Email — defaults to Mailpit, the local SMTP sink (./scripts/start-mailpit.sh).
# It captures every message without delivering it and shows them at
# http://localhost:8025, so any recipient address works while developing.
# Any SMTP provider works unchanged; only these values decide which one.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=dev
MAIL_PASS=dev
# Optional envelope "From" — falls back to MAIL_USER when unset. Accepts a
# display name.
MAIL_FROM="Invitae <no-reply@invitae.local>"
#
# Real provider (Resend over SMTP — MAIL_USER is the literal string `resend`,
# MAIL_PASS is the API key):
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USER=resend
#   MAIL_PASS=re_change_me
#   MAIL_FROM="Invitae <onboarding@resend.dev>"
# Careful: with the `onboarding@resend.dev` sandbox sender, Resend only delivers
# to the exact address of the account owner and answers 550 for anyone else —
# plus-addressing does NOT get around it. Verify a domain at resend.com/domains
# and use it in MAIL_FROM to reach real recipients.

# OAuth (optional). The *_USER_CALLBACK_URL pair belongs to the user dashboard
# flow (/auth/<provider>/user); the plain ones belong to the admin dashboard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_USER_CALLBACK_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=
FACEBOOK_USER_CALLBACK_URL=

# Frontends — ALSO the CORS allow-list. Cookie auth requires credentialed CORS,
# and `Access-Control-Allow-Origin: *` is invalid with credentials, so any
# origin missing here has every response rejected by the browser.
DASHBOARD_URL=http://localhost:8090
USER_DASHBOARD_URL=http://localhost:8091
# Public invitation site (`templates`); guests open /<slug>?uuid_guess=<guestId>.
INVITATION_URL=http://localhost:8095

# Public base URL of THIS API. Used to build links that land back here from
# outside the browser session — currently the email-confirmation link. Optional;
# falls back to http://localhost:3000. Set it in any deployed environment or the
# confirmation emails will point users at their own machine.
API_PUBLIC_URL=http://localhost:3000

# Session cookies. Each dashboard gets its OWN cookie name (invitae_admin_session
# / invitae_user_session) because cookies are not scoped by port: localhost:8090,
# localhost:8091 and localhost:3000 share one jar, so a shared name made the two
# apps overwrite each other's session.
# SAMESITE: 'lax' is correct while the dashboard and the API share a registrable
#   domain — ports are not part of a "site", so localhost:8091 -> localhost:3000
#   and app.invitae.com -> api.invitae.com both qualify. Use 'none' ONLY for
#   genuinely different sites; browsers then also require Secure, so HTTPS
#   becomes mandatory.
# DOMAIN: leave empty for a host-only cookie. Set it (e.g. .invitae.com) when the
#   dashboard and API live on different subdomains, or the API never sees it.
# Misconfiguring these fails SILENTLY — the browser just stops sending the
# cookie and every request looks logged out.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
# Defaults to true when NODE_ENV=production; forced true whenever SAMESITE=none.
AUTH_COOKIE_SECURE=
